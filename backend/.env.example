# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# Anthropic API Configuration (for AI duplicate detection)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# DeepSeek API Configuration (server-wide fallback; users can also supply their
# own key via the AI Settings page, which takes priority)
# Get your API key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# AI Provider Selection
AI_PROVIDER=anthropic  # Options: 'anthropic', 'openai', or 'deepseek'
AI_MODEL=claude-3-5-sonnet-20241022  # Claude 3.5 Sonnet (latest)
AI_MAX_TOKENS=4096
AI_COST_LIMIT_PER_USER_PER_MONTH=50.00  # USD

# Encryption key for storing per-user AI API keys at rest (Fernet).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_KEY_ENCRYPTION_KEY=generate-a-fernet-key-and-put-it-here

# Instructions:
# 1. Copy this file to .env (in the same directory)
# 2. Replace 'your-api-key-here' with your actual OpenAI API key
# 3. Replace 'your-anthropic-api-key-here' with your Anthropic API key
# 4. Replace 'your-deepseek-api-key-here' with your DeepSeek API key (or let users supply their own)
# 5. Generate AI_KEY_ENCRYPTION_KEY as shown above
# 6. Make sure .env is in your .gitignore to keep your key secure
